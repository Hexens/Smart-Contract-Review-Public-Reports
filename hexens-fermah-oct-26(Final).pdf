  << /ActualText (uint256 seedRefund \075 Math\056min\050\137pendingSeedRefund\050\051\054 recoverable\051\073\n\056\056\056\nswept \075 recoverable \055 seedRefund\073\nuint256 creatorCut \075 Math\056mulDiv\050swept\054 creatorBps\054 BPS\137DENOM\051\073\nuint256 treasuryCut \075 swept \055 creatorCut\073)
     /K [ 12 ]
     /P 20071 0 R
     /Pg 4054 0 R
     /S /Span
     /Type /StructElem
  >>
