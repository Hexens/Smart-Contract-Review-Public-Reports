20139 0 obj
  << /ActualText (        \057\057 Provider P\046L as in the issue\072 seed result plus bet result\n        \057\057 \050excluding its creatorBps share of the house take\051\056\n        r\056providerPnl \075 int256\050r\056seedRefund\051 \055 int256\050seed\051 \053 int256\050r\056providerPayout\051 \055 int256\050providerBet\051\073\n    \175\n\n    function \137log\050string memory label\054 Result memory r\051 internal pure \173\n        console\056log\050label\051\073\n        console\056log\050\042  seed refund      \042\054 r\056seedRefund\051\073\n        console\056log\050\042  house take       \042\054 r\056houseTake\051\073\n        console\056log\050\042  provider payout  \042\054 r\056providerPayout\051\073\n        console\056logInt\050r\056providerPnl\051\073\n    \175\n\n    function test\137Issue13\137SeedProviderHedgeIsFree\050\051 public \173\n        Result memory yesBase \075 \137run\0500\054 YES\051\073\n        Result memory noBase \075 \137run\0500\054 NO\051\073\n        Result memory yesHedge \075 \137run\0501\137000 \052 USDC\054 YES\051\073\n        Result memory noHedge \075 \137run\0501\137000 \052 USDC\054 NO\051\073\n\n        \137log\050\042YES wins\054 no provider bet\042\054 yesBase\051\073\n        \137log\050\042NO wins\054  no provider bet\042\054 noBase\051\073\n        \137log\050\042YES wins\054 provider bets 1\054000 NO\042\054 yesHedge\051\073\n        \137log\050\042NO wins\054  provider bets 1\054000 NO\042\054 noHedge\051\073\n\n        \057\057 Book state from the issue\056\n        console\056log\050\042Bob YES shares                \042\054 yesBase\056bobShares\051\073\n        console\056log\050\042Carol NO shares               \042\054 yesBase\056carolShares\051\073\n        console\056log\050\042provider NO shares            \042\054 yesHedge\056providerShares\051\073\n\n        \057\057 Table in the issue\056\n        console\056log\050\042YES\054 no bet\072 seed refund      \042\054 yesBase\056seedRefund\051\073\n        console\056log\050\042YES\054 bet\072 seed refund         \042\054 yesHedge\056seedRefund\051\073\n        console\056log\050\042YES\054 no bet\072 provider P\046L     \042\054 yesBase\056providerPnl\051\073\n        console\056log\050\042YES\054 bet\072 provider P\046L        \042\054 yesHedge\056providerPnl\051\073\n        console\056log\050\042NO\054 bet\072 provider payout      \042\054 noHedge\056providerPayout\051\073\n        console\056log\050\042NO\054 no bet\072 provider P\046L      \042\054 noBase\056providerPnl\051\073\n        console\056log\050\042NO\054 bet\072 provider P\046L         \042\054 noHedge\056providerPnl\051\073\n        console\056log\050\042NO\054 no bet\072 house take        \042\054 noBase\056houseTake\051\073\n        console\056log\050\042NO\054 bet\072 house take           \042\054 noHedge\056houseTake\051\073\n\n        \057\057 The core claims\072 the bet is free if YES wins\054 and the gain if NO wins)
